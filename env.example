# ==============================================================================
# Taller Mecánico API - Configuración de Variables de Entorno
# ==============================================================================
# Copie este archivo como .env y ajuste los valores requeridos antes de iniciar:
#   cp env.example .env
#
# IMPORTANTE: El archivo .env NUNCA debe ser comiteado en el repositorio git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Conexión a Base de Datos (PostgreSQL 16+)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_aqui
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=taller_mecanico

# Tamaño del pool de conexiones para SQLAlchemy y asyncpg
DATABASE_POOL_SIZE=10

# ------------------------------------------------------------------------------
# Seguridad y Tokens JWT
# ------------------------------------------------------------------------------
# Clave secreta criptográfica para firmar los tokens JWT (mínimo 32 bytes).
# Genere una clave segura en su terminal ejecutando:
#   openssl rand -hex 32
JWT_SECRET_KEY=tu_clave_secreta_aqui_generada_con_openssl_rand_hex_32

# Algoritmo de firma de tokens (HS256)
JWT_ALGORITHM=HS256

# Tiempo de vida de la sesión y cookie en segundos (1800s = 30 minutos)
JWT_EXPIRATION_SECONDS=1800

# Bandera Secure en cookies: False para desarrollo HTTP local, True para HTTPS producción
COOKIE_SECURE=False

# ------------------------------------------------------------------------------
# Hashing de Contraseñas (bcrypt)
# ------------------------------------------------------------------------------
# Factor de costo de trabajo para bcrypt (recomendado 12 en producción)
BCRYPT_ROUNDS=12

# Límite máximo de verificaciones/hashes concurrentes fuera del event loop (semáforo)
MAX_CONCURRENT_BCRYPT=4

# ------------------------------------------------------------------------------
# Diagnóstico y Logging SQL
# ------------------------------------------------------------------------------
# Activa el logging detallado de cada sentencia SQL emitida por SQLAlchemy en consola
SQL_ECHO=False
